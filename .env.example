# farm - environment configuration template.
#
# Copy this file to `.env` and fill in real values. The `.env` file is
# git-ignored and read automatically by Django (farm/settings.py) and by
# `docker compose` for variable interpolation.

# --- Core -----------------------------------------------------------------
# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Leave unset (or 0) in production; set to 1 for local development.
# DJANGO_DEBUG=1

# Comma-separated list of hostnames that may serve this site.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for unsafe (POST) requests
# (scheme + host), e.g. https://farm.example.com.
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------------
# Defaults to the local SQLite file when unset. Examples:
#   sqlite:///db.sqlite3
#   sqlite:////data/db.sqlite3
#   postgres://user:password@host:5432/farm
DJANGO_DATABASE_URL=

# --- Static / media -------------------------------------------------------
# DJANGO_STATIC_ROOT=/app/staticfiles
# DJANGO_MEDIA_ROOT=/data/media

# --- Security (production only) ------------------------------------------
# Set to 0 only when TLS is NOT terminated in front of the app (local runs).
DJANGO_SECURE_SSL_REDIRECT=1
# Max-age (seconds) for HTTP Strict Transport Security; default 1 year.
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Error reporting (optional) ------------------------------------------
# "Name:email,Name2:email2" receives traceback emails for unhandled 500s.
DJANGO_ADMINS=
# DJANGO_SERVER_EMAIL=noreply@example.com
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=1

# --- Logging --------------------------------------------------------------
# DJANGO_LOG_LEVEL=INFO
